{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "bash": {
      "*": "deny",
      "gh api repos/*": "allow",
      "gh api * -X *": "deny",
      "* --method *": "deny",
      "* -f *": "deny",
      "* -F *": "deny",
      "* --field *": "deny",
      "* --raw-field *": "deny",
      "* --input *": "deny"
    },
    "apply_patch": "deny",
    "edit": "deny",
    "external_directory": "deny",
    "glob": "deny",
    "grep": "deny",
    "lsp": "deny",
    "read": "deny",
    "task": "deny",
    "websearch": "deny",
    "webfetch": "deny",
    "write": "deny",
    "switch_*": "allow"
  }
}
