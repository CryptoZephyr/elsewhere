<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="images/logo.svg">
  <link rel="preload" href="fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="fonts/dm-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="page">
    <header class="site-header">
      <a class="brand" href="index.html"{% if page.url == "/index.html" or page.url == "/" %} aria-current="page"{% endif %}>
        <img src="images/logo.svg" alt="" aria-hidden="true">
        <span>Elsewhere</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="setup.html"{% if page.url == "/setup.html" %} aria-current="page"{% endif %}>Setup</a>
        <a href="how-it-works.html"{% if page.url == "/how-it-works.html" %} aria-current="page"{% endif %}>How it works</a>
        <a href="https://github.com/CryptoZephyr/elsewhere">GitHub</a>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <a class="brand brand--footer" href="index.html">
        <img src="images/logo.svg" alt="" aria-hidden="true">
        <span>Elsewhere</span>
      </a>
      <nav class="footer-links" aria-label="Footer">
        <a href="index.html">Elsewhere</a>
        <a href="setup.html">Setup</a>
        <a href="how-it-works.html">How it works</a>
        <a href="https://github.com/CryptoZephyr/elsewhere">GitHub</a>
      </nav>
    </footer>
  </div>
</body>
</html>
